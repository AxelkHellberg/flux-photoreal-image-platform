# Core application
APP_ENV=development
LOG_LEVEL=INFO
MAX_ATTEMPTS=3
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=60
PROGRESS_TIMEOUT_SECONDS=300
REAPER_INTERVAL_SECONDS=15

# API
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_API_BASE_URL=http://localhost:18000
CORS_ORIGINS=http://localhost:3000

# Postgres
# Local-only default for docker-compose development.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/image_platform

# Redis
REDIS_URL=redis://localhost:6380/0
REDIS_QUEUE_NAME=image_jobs:v1

# Storage
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9002
S3_REGION=auto
S3_BUCKET=image-platform-images
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://localhost:9002/image-platform-images
LOCAL_STORAGE_ROOT=./storage
CHECKPOINT_S3_ENDPOINT_URL=
CHECKPOINT_S3_REGION=auto
CHECKPOINT_S3_BUCKET=
CHECKPOINT_S3_PREFIX=flux1-krea-dev
CHECKPOINT_S3_ACCESS_KEY_ID=
CHECKPOINT_S3_SECRET_ACCESS_KEY=
CHECKPOINT_S3_USE_SSL=true

# Generation
IMAGE_GENERATOR_BACKEND=flux
ENABLE_PROMPT_ENHANCER=false
HF_TOKEN=
FLUX_MODEL_ID=black-forest-labs/FLUX.1-Krea-dev
MODEL_CACHE_DIR=/opt/image-platform/model-cache
FLUX_DTYPE=bfloat16
FLUX_DEVICE=cuda
FLUX_ENABLE_MODEL_CPU_OFFLOAD=true
FLUX_NUM_INFERENCE_STEPS=30
FLUX_GUIDANCE_SCALE=4.5
WORKER_ID=worker-local
WORKER_POLL_TIMEOUT_SECONDS=5

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:18000

# Local control plane
# Local-only defaults for docker-compose development.
POSTGRES_DB=image_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Remote worker deployment
RUNPOD_HOST=
RUNPOD_USER=root
RUNPOD_SSH_KEY_PATH=
RUNPOD_SSH_PORT=22
RUNPOD_APP_DIR=/opt/image-platform
RUNPOD_REVERSE_TUNNEL_POSTGRES_PORT=15432
RUNPOD_REVERSE_TUNNEL_REDIS_PORT=16379
RUNPOD_REVERSE_TUNNEL_API_PORT=18000
REMOTE_OUTPUT_DIR=./outputs
OPEN_GENERATED_IMAGE=true
