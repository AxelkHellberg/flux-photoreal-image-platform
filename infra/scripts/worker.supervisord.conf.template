[program:image-platform-worker]
directory={{APP_DIR}}
command=/usr/local/bin/uv run --package image-platform-worker python -m image_platform_worker.main
autostart=true
autorestart=true
startsecs=30
priority=20
stdout_logfile={{APP_DIR}}/logs/worker.stdout.log
stderr_logfile={{APP_DIR}}/logs/worker.stderr.log
environment=APP_ENV="production",PYTHONUNBUFFERED="1",DATABASE_URL="{{DATABASE_URL}}",REDIS_URL="{{REDIS_URL}}",REDIS_QUEUE_NAME="{{REDIS_QUEUE_NAME}}",STORAGE_BACKEND="s3",S3_ENDPOINT_URL="{{S3_ENDPOINT_URL}}",S3_REGION="{{S3_REGION}}",S3_BUCKET="{{S3_BUCKET}}",S3_ACCESS_KEY_ID="{{S3_ACCESS_KEY_ID}}",S3_SECRET_ACCESS_KEY="{{S3_SECRET_ACCESS_KEY}}",S3_USE_SSL="{{S3_USE_SSL}}",PUBLIC_API_BASE_URL="{{PUBLIC_API_BASE_URL}}",IMAGE_GENERATOR_BACKEND="flux",HF_TOKEN="{{HF_TOKEN}}",FLUX_MODEL_ID="{{FLUX_MODEL_ID}}",MODEL_CACHE_DIR="{{MODEL_CACHE_DIR}}",FLUX_DTYPE="{{FLUX_DTYPE}}",FLUX_DEVICE="{{FLUX_DEVICE}}",FLUX_ENABLE_MODEL_CPU_OFFLOAD="{{FLUX_ENABLE_MODEL_CPU_OFFLOAD}}",FLUX_NUM_INFERENCE_STEPS="{{FLUX_NUM_INFERENCE_STEPS}}",FLUX_GUIDANCE_SCALE="{{FLUX_GUIDANCE_SCALE}}",WORKER_ID="{{WORKER_ID}}",HEARTBEAT_INTERVAL_SECONDS="{{HEARTBEAT_INTERVAL_SECONDS}}",HEARTBEAT_TIMEOUT_SECONDS="{{HEARTBEAT_TIMEOUT_SECONDS}}",PROGRESS_TIMEOUT_SECONDS="{{PROGRESS_TIMEOUT_SECONDS}}",ENABLE_PROMPT_ENHANCER="{{ENABLE_PROMPT_ENHANCER}}"
