{
  "name": "image-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "test:shared": "node --experimental-strip-types --test packages/shared/typescript/tests/*.test.mjs",
    "dev:web": "pnpm --filter @image-platform/web dev",
    "build:web": "pnpm --filter @image-platform/web build",
    "lint:web": "pnpm --filter @image-platform/web lint",
    "typecheck:web": "pnpm --filter @image-platform/web typecheck"
  }
}
